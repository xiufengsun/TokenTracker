{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TokenTracker",
  "version": "1.3.4",
  "identifier": "cc.tokentracker.linux",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/tokentracker.desktop.hbs",
        "files": {
          "/usr/share/gnome-shell/extensions/tokentracker@tokentracker.cc/metadata.json": "../gnome-extension/tokentracker@tokentracker.cc/metadata.json",
          "/usr/share/gnome-shell/extensions/tokentracker@tokentracker.cc/extension.js": "../gnome-extension/tokentracker@tokentracker.cc/extension.js",
          "/usr/share/gnome-shell/extensions/tokentracker@tokentracker.cc/stylesheet.css": "../gnome-extension/tokentracker@tokentracker.cc/stylesheet.css"
        }
      },
      "rpm": {
        "desktopTemplate": "linux/tokentracker.desktop.hbs",
        "files": {
          "/usr/share/gnome-shell/extensions/tokentracker@tokentracker.cc/metadata.json": "../gnome-extension/tokentracker@tokentracker.cc/metadata.json",
          "/usr/share/gnome-shell/extensions/tokentracker@tokentracker.cc/extension.js": "../gnome-extension/tokentracker@tokentracker.cc/extension.js",
          "/usr/share/gnome-shell/extensions/tokentracker@tokentracker.cc/stylesheet.css": "../gnome-extension/tokentracker@tokentracker.cc/stylesheet.css"
        }
      }
    }
  }
}
