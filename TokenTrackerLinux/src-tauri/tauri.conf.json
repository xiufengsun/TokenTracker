{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TokenTracker",
  "version": "1.1.2",
  "identifier": "cc.tokentracker.linux",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/tokentracker.desktop.hbs"
      },
      "rpm": {
        "desktopTemplate": "linux/tokentracker.desktop.hbs"
      }
    }
  }
}
