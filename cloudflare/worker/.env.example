# Copy to a local 0600 file. Never commit real values.
# Worker builds with TT_QA_OAUTH enabled must set TT_QA_AUTH_ORIGIN explicitly.
TT_QA_AUTH_ORIGIN=
TT_QA_BASE_URL=https://api-qa-tokentracker-migration-staging.sunxiufeng1992.workers.dev
TT_QA_ID=
TT_QA_EMAIL=
TT_QA_PASSWORD=
TT_QA_REFRESH_SECRET=
TT_QA_RECEIPT=/tmp/tokentracker-qa-receipt.json

# Optional second synthetic account for cross-user isolation checks.
TT_QA_OTHER_ID=
TT_QA_OTHER_EMAIL=
TT_QA_OTHER_PASSWORD=
TT_QA_OTHER_ACCESS_TOKEN=
